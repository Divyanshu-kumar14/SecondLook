# ─── Node ───────────────────────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# ─── Local tooling / agent caches ───────────────────────────────────────
# NOTE: the on-disk directory is `.token-optimizer` (with an "r").
.token-optimizer/
.token-optimiser/
.opencode/
.orchestrator/

# ─── Runtime data (regenerated by `npm run seed`, never source) ─────────
.data/

# ─── Test artefacts ─────────────────────────────────────────────────────
coverage/

# Live-UI check screenshots. Regenerated by `npm run verify-ui`, never source.
# Screenshots that belong in the README are committed under docs/assets/.
.artifacts/

# ─── Secrets & local env ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── OS / editor noise ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# NOTE: `specs/`, `tests/` and `docs/` are deliberately NOT ignored.
# DECISIONS.md, FRICTION_LOG.md and the phase advancement summaries are
# submission evidence (DoD #9) and must reach GitHub.